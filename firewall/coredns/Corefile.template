// CoreDNS template configuration for sandbox firewall.
// This file is a reference — the actual config is generated by entrypoint.sh
// based on environment variables (ALLOW_DOMAINS, DENY_DOMAINS, DNS_DEFAULT, DNS_UPSTREAM).
//
// Example: restrict to anthropic.com only, deny evil.anthropic.com
//
//   ALLOW_DOMAINS=anthropic.com,*.anthropic.com
//   DENY_DOMAINS=evil.anthropic.com
//   DNS_DEFAULT=deny
//   DNS_UPSTREAM=1.1.1.1,8.8.8.8
.:53 {
    errors
    log

    // Deny zones (deny wins — checked first)
    template IN ANY evil.anthropic.com {
        rcode NXDOMAIN
    }

    // Forward allowed domains to upstream
    anthropic.com {
        forward . 1.1.1.1 8.8.8.8
    }
    *.anthropic.com {
        forward . 1.1.1.1 8.8.8.8
    }

    // Default: NXDOMAIN for everything else (deny mode)
    . {
        template IN ANY {
            rcode NXDOMAIN
        }
    }
}
